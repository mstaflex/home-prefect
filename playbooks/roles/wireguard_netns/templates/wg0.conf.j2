# Managed by Ansible — do not edit manually
# WireGuard interface config (raw wg params — no wg-quick sections)

[Interface]
PrivateKey={{ wg_private_key }}

{% for wg_peer_public_key, wg_peer_tunnel_ip in wg_peer_public_keys | zip(wg_peer_tunnel_ips) %}
[Peer]
PublicKey={{ wg_peer_public_key }}
AllowedIPs={{ wg_peer_tunnel_ip }}
Endpoint={{ wg_peer_endpoint }}
PersistentKeepalive={{ wg_keepalive }}

{% endfor %}
